# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Server ---
PORT=5000
NODE_ENV=development

# Must match the origin your React site is served from (no trailing slash).
# Local dev default: http://localhost:5173
# Production: https://www.wiseengineeringconsultantspvt.ltd
FRONTEND_URL=http://localhost:5173

# --- SMTP (GoDaddy Email / Microsoft 365 / Office 365 example values shown) ---
# GoDaddy webmail:      smtpout.secureserver.net   port 465 (SSL) or 587 (TLS)
# Microsoft 365:        smtp.office365.com         port 587 (TLS)
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=info@wiseengineeringconsultantspvt.ltd
SMTP_PASS=your-mailbox-password

# Sender address shown in the "From" header — normally the same as SMTP_USER.
FROM_EMAIL=info@wiseengineeringconsultantspvt.ltd

# Where enquiry notifications are delivered.
TO_EMAIL=info@wiseengineeringconsultantspvt.ltd

# --- Google reCAPTCHA v3 ---
# Get keys from https://www.google.com/recaptcha/admin — register the site
# with type "v3". Leave blank to disable reCAPTCHA verification (dev only).
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
