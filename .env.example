# EmailJS credentials — used only by the Careers "Apply Now" form.
# Get these from https://dashboard.emailjs.com
# Copy this file to .env and fill in your real values.
# On Vercel: add the same variables under Project Settings > Environment Variables.

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Contact Us form backend (see /server) — the Express API base URL.
# Local dev default: http://localhost:5000
# Production: https://api.wiseengineeringconsultantspvt.ltd (or wherever the backend is hosted)
VITE_API_URL=http://localhost:5000

# Google reCAPTCHA v3 site key (public) — from https://www.google.com/recaptcha/admin
# Must match the RECAPTCHA_SECRET_KEY configured in server/.env. Leave blank to disable.
VITE_RECAPTCHA_SITE_KEY=
